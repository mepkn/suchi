# ---------------------------------------------------------------------------
# Frontend (.env.local) — written for you by `npx convex dev` (local deployment)
# ---------------------------------------------------------------------------
CONVEX_DEPLOYMENT=local:<generated-name>
VITE_CONVEX_URL=http://127.0.0.1:3210
VITE_CONVEX_SITE_URL=http://127.0.0.1:3211

# ---------------------------------------------------------------------------
# Convex-side env vars — set on EACH deployment with `npx convex env set`
# (NOT read from this file)
# ---------------------------------------------------------------------------
# SITE_URL=http://localhost:5173
# ALLOWED_EMAILS=you@example.com,other@example.com
# JWT_PRIVATE_KEY=...   } generate both with: npm run setup:auth
# JWKS=...              }
